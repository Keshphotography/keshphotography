---
// Universal Video Embed — paste any YouTube, Instagram, TikTok or Facebook link.
// Auto-detects platform + aspect ratio (16:9 widescreen vs 9:16 vertical) and frames it cleanly.
const { url = "", forceVertical = false, thumbnail = "" } = Astro.props;

function parse(u){
  if(!u) return null;
  try{
    const s = u.trim();
    // YouTube (watch, youtu.be, shorts, embed)
    let m = s.match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/)|youtu\.be\/)([A-Za-z0-9_-]{6,})/);
    if(m){
      const vertical = /shorts\//.test(s) || forceVertical;
      return { platform:'youtube', embed:`https://www.youtube.com/embed/${m[1]}?rel=0`, vertical };
    }
    // TikTok
    m = s.match(/tiktok\.com\/.*\/video\/(\d+)/) || s.match(/tiktok\.com\/t\/([A-Za-z0-9]+)/);
    if(/tiktok\.com/.test(s)){
      const id = m ? m[1] : "";
      return { platform:'tiktok', embed:`https://www.tiktok.com/embed/v2/${id}`, vertical:true };
    }
    // Instagram (reel or post)
    m = s.match(/instagram\.com\/(reel|reels|p)\/([A-Za-z0-9_-]+)/);
    if(m){
      return { platform:'instagram', embed:`https://www.instagram.com/${m[1]==='reels'?'reel':m[1]}/${m[2]}/embed`, vertical:true };
    }
    // Facebook
    if(/facebook\.com/.test(s) || /fb\.watch/.test(s)){
      const enc = encodeURIComponent(s);
      return { platform:'facebook', embed:`https://www.facebook.com/plugins/video.php?href=${enc}&show_text=false`, vertical: forceVertical };
    }
    // Vimeo (bonus)
    m = s.match(/vimeo\.com\/(\d+)/);
    if(m){ return { platform:'vimeo', embed:`https://player.vimeo.com/video/${m[1]}`, vertical:forceVertical }; }
  }catch(e){}
  return null;
}
const v = parse(url);
const ratioClass = v && v.vertical ? 'ratio-vertical' : 'ratio-wide';
---
{v ? (
  <div class={`embed ${ratioClass}`} data-platform={v.platform}>
    <iframe src={v.embed} loading="lazy" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen title="Keshphotography video"></iframe>
  </div>
) : (
  <div class="embed ratio-wide embed-fallback">
    {thumbnail ? <img src={thumbnail} alt="Video preview"/> : <span>Paste a YouTube, Instagram, TikTok or Facebook link in /admin</span>}
  </div>
)}
<style>
  .embed{position:relative;width:100%;background:#000;border-radius:14px;overflow:hidden;border:1px solid var(--line)}
  .ratio-wide{aspect-ratio:16/9}
  .ratio-vertical{aspect-ratio:9/16;max-width:420px;margin:0 auto}
  .embed iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
  .embed-fallback{display:flex;align-items:center;justify-content:center;color:#ccc;font-size:14px;text-align:center;padding:20px}
  .embed-fallback img{width:100%;height:100%;object-fit:cover}
</style>
