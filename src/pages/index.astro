---
import Base from '../layouts/Base.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import site from '../data/site.json';
import hero from '../data/hero.json';
import about from '../data/about.json';
import servicesData from '../data/services.json';
import portfolioData from '../data/portfolio.json';
const services = servicesData.services;
const portfolio = portfolioData.portfolio;
const categories = ["All","Documentaries & Travel","Cinematography & Reels","Corporate & Events","Creative Shoots"];
---
<Base>
  <!-- ===== STORY LENS HERO ===== -->
  <section class="hero" id="top">
    <img class="hero-layer back" src={hero['01_Hero_Layer_Back']} alt=""/>
    <img class="hero-layer front" src={hero['01_Hero_Featured_Visual']} alt=""/>
    <div class="hero-scrim"></div>
    <div class="viewfinder" aria-hidden="true">
      <span class="vf tl"></span><span class="vf tr"></span><span class="vf bl"></span><span class="vf br"></span>
      <span class="vf-coord">{hero['01_Hero_Coordinates']}</span>
      <span class="vf-rec">● REC</span>
    </div>
    <div class="hero-inner wrap">
      <p class="eyebrow" style="color:#e9c892">{hero['01_Hero_Eyebrow']}</p>
      <h1 class="hero-title">{hero['01_Hero_Headline']}</h1>
      <p class="hero-sub">{hero['01_Hero_Subtext']}</p>
      <div class="hero-cta">
        <a class="btn btn-gold" href="#work">View the work</a>
        <a class="btn" style="color:#fff;border-color:#fff" href="#story">Build your story</a>
      </div>
    </div>
  </section>

  <!-- ===== SERVICES ===== -->
  <section class="section" id="services">
    <div class="wrap">
      <p class="eyebrow">What I do</p>
      <h2 class="h2">Three ways I help you tell a story</h2>
      <div class="svc-grid">
        {services.map(s => (
          <div class="svc">
            <h3 class="svc-t">{s.title}</h3>
            <p class="muted">{s.blurb}</p>
            <ul class="svc-list">{s.items.map(i => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== FILTERABLE PORTFOLIO ===== -->
  <section class="section work" id="work">
    <div class="wrap">
      <p class="eyebrow">Selected work</p>
      <h2 class="h2">The Portfolio</h2>
      <div class="filters" id="filters">
        {categories.map((c,i) => <button class={`filt ${i===0?'on':''}`} data-cat={c}>{c}</button>)}
      </div>
      <div class="grid" id="grid">
        {portfolio.map((p,idx) => (
          <article class="card" data-cat={p.category}
            data-type={p.type} data-url={p.media_url}
            data-title={p['03_Portfolio_Title']} data-loc={p.story_location}
            data-client={p.story_client} data-notes={p.story_notes}>
            <div class={`card-media ${p.type==='video_vertical'?'is-vert':''}`}>
              <img src={p.thumbnail} alt={p['03_Portfolio_Title']} loading="lazy"/>
              {(p.type==='video'||p.type==='video_vertical') && <span class="playbadge">▶</span>}
            </div>
            <div class="card-cap">
              <span class="card-title">{p['03_Portfolio_Title']}</span>
              <span class="card-cat">{p.category}</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== ABOUT ===== -->
  <section class="section about" id="about">
    <div class="wrap about-grid">
      <img class="about-pic" src={about['02_About_Kesh_Portrait']} alt="Mukeshi Martin"/>
      <div>
        <p class="eyebrow">{about['02_About_Eyebrow']}</p>
        <h2 class="h2">{about['02_About_Heading']}</h2>
        <p class="muted" style="margin-bottom:26px">{about['02_About_Body']}</p>
        <div class="stats">
          <div><b>{about['02_About_Stat1_Number']}</b><span>{about['02_About_Stat1_Label']}</span></div>
          <div><b>{about['02_About_Stat2_Number']}</b><span>{about['02_About_Stat2_Label']}</span></div>
          <div><b>{about['02_About_Stat3_Number']}</b><span>{about['02_About_Stat3_Label']}</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== BUILD YOUR STORY (quote builder, Netlify Forms) ===== -->
  <section class="section story" id="story">
    <div class="wrap narrow">
      <p class="eyebrow center">Build your story</p>
      <h2 class="h2 center">Let's plan your project</h2>
      <p class="muted center" style="max-width:52ch;margin:0 auto 34px">Answer a few quick questions and I'll come back to you with a tailored plan and quote.</p>

      <form name="build-your-story" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="builder" id="builder">
        <input type="hidden" name="form-name" value="build-your-story"/>
        <p style="display:none"><label>Don't fill this: <input name="bot-field"/></label></p>

        <div class="step" data-step="1">
          <span class="step-n">01 · Service</span>
          <div class="opts">
            {["Photography","Cinematography","Media Consultation"].map(o =>
              <label class="opt"><input type="radio" name="service" value={o} required/><span>{o}</span></label>)}
          </div>
        </div>
        <div class="step" data-step="2">
          <span class="step-n">02 · Shoot type</span>
          <div class="opts">
            {["Wedding / Ruracio","Event / Corporate","Brand / Product","Documentary / Travel","Portrait / Creative","Other"].map(o =>
              <label class="opt"><input type="radio" name="shoot_type" value={o} required/><span>{o}</span></label>)}
          </div>
        </div>
        <div class="step" data-step="3">
          <span class="step-n">03 · Timeline</span>
          <div class="opts">
            {["Within 2 weeks","This month","1–3 months","Just exploring"].map(o =>
              <label class="opt"><input type="radio" name="timeline" value={o} required/><span>{o}</span></label>)}
          </div>
        </div>
        <div class="step" data-step="4">
          <span class="step-n">04 · Deliverables</span>
          <div class="opts">
            {["Edited photos","A film / reel","Both photo & video","Not sure yet"].map(o =>
              <label class="opt"><input type="radio" name="deliverables" value={o} required/><span>{o}</span></label>)}
          </div>
        </div>
        <div class="step" data-step="5">
          <span class="step-n">05 · Your details</span>
          <div class="fields">
            <input name="name" placeholder="Your name" required/>
            <input name="email" type="email" placeholder="Email" required/>
            <input name="phone" placeholder="Phone / WhatsApp"/>
            <textarea name="message" placeholder="Anything else about your project?" rows="3"></textarea>
          </div>
        </div>
        <button type="submit" class="btn btn-gold" style="width:100%;margin-top:12px">Send my project brief</button>
        <p class="muted center" style="font-size:13px;margin-top:14px">Or reach me directly at <a href={`mailto:${site.email}`} style="color:var(--gold)">{site.email}</a></p>
      </form>
    </div>
  </section>

  <!-- ===== SCREENING ROOM LIGHTBOX ===== -->
  <div class="lightbox" id="lightbox" aria-hidden="true">
    <button class="lb-close" id="lbClose" aria-label="Close">&times;</button>
    <div class="lb-inner">
      <div class="lb-media" id="lbMedia"></div>
      <div class="lb-story">
        <p class="eyebrow" id="lbClient"></p>
        <h3 class="serif" id="lbTitle"></h3>
        <p class="lb-loc muted" id="lbLoc"></p>
        <p class="lb-notes" id="lbNotes"></p>
      </div>
    </div>
  </div>

  <style>
    .h2{font-size:clamp(1.9rem,4vw,2.8rem);margin:14px 0 34px}
    .narrow{max-width:720px}
    /* hero */
    .hero{position:relative;min-height:100svh;display:flex;align-items:flex-end;overflow:hidden;background:#0d0d0d}
    .hero-layer{position:absolute;inset:-6% ;width:112%;height:112%;object-fit:cover;will-change:transform}
    .hero-layer.back{opacity:.5;filter:saturate(.8)}
    .hero-layer.front{opacity:.92}
    .hero-scrim{position:absolute;inset:0;background:linear-gradient(180deg,rgba(13,13,13,.4),rgba(13,13,13,0) 35%,rgba(13,13,13,.25) 60%,rgba(13,13,13,.9) 100%)}
    .hero-inner{position:relative;z-index:3;padding-bottom:8vh;color:#fff}
    .hero-title{font-size:clamp(2.6rem,7vw,5.4rem);max-width:16ch;text-shadow:0 4px 30px rgba(0,0,0,.5)}
    .hero-sub{font-size:20px;max-width:46ch;margin:22px 0 30px;color:#f0ece4;text-shadow:0 2px 12px rgba(0,0,0,.6)}
    .hero-cta{display:flex;gap:14px;flex-wrap:wrap}
    .viewfinder{position:absolute;inset:7% 6%;z-index:2;pointer-events:none}
    .vf{position:absolute;width:34px;height:34px;border:2px solid rgba(255,255,255,.8)}
    .vf.tl{top:0;left:0;border-right:0;border-bottom:0}
    .vf.tr{top:0;right:0;border-left:0;border-bottom:0}
    .vf.bl{bottom:0;left:0;border-right:0;border-top:0}
    .vf.br{bottom:0;right:0;border-left:0;border-top:0}
    .vf-coord{position:absolute;bottom:0;left:50%;transform:translateX(-50%);font-family:var(--sans);font-size:12px;letter-spacing:2px;color:rgba(255,255,255,.85);background:rgba(0,0,0,.3);padding:4px 12px;border-radius:20px}
    .vf-rec{position:absolute;top:2px;right:6px;font-size:12px;letter-spacing:2px;color:#ff6b6b}
    /* services */
    .svc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line)}
    .svc{background:var(--paper);padding:34px 30px;min-height:240px}
    .svc-t{font-size:1.6rem;margin-bottom:12px}
    .svc-list{list-style:none;margin-top:18px}
    .svc-list li{padding:6px 0;border-top:1px solid var(--line);font-size:15px}
    /* portfolio */
    .work{background:color-mix(in srgb,var(--ink) 4%,var(--paper))}
    .filters{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:30px}
    .filt{background:none;border:1px solid var(--line);color:var(--ink);padding:8px 18px;border-radius:40px;font-family:var(--sans);font-size:14px;cursor:pointer;opacity:.75;transition:.2s}
    .filt:hover{opacity:1}
    .filt.on{background:var(--ink);color:var(--paper);opacity:1;border-color:var(--ink)}
    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
    .card{cursor:pointer;background:var(--card);border:1px solid var(--line);border-radius:12px;overflow:hidden;transition:transform .25s}
    .card:hover{transform:translateY(-4px)}
    .card-media{position:relative;aspect-ratio:4/3;overflow:hidden}
    .card-media.is-vert{aspect-ratio:3/4}
    .card-media img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
    .card:hover .card-media img{transform:scale(1.05)}
    .playbadge{position:absolute;inset:0;margin:auto;width:54px;height:54px;border-radius:50%;background:rgba(0,0,0,.5);color:#fff;display:flex;align-items:center;justify-content:center;font-size:18px;backdrop-filter:blur(3px)}
    .card-cap{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:14px 16px}
    .card-title{font-family:var(--serif);font-weight:600;font-size:16px}
    .card-cat{font-size:11px;letter-spacing:1px;color:var(--muted);text-transform:uppercase}
    /* about */
    .about-grid{display:grid;grid-template-columns:1fr 1.2fr;gap:54px;align-items:center}
    .about-pic{aspect-ratio:4/5;object-fit:cover;border-radius:14px}
    .stats{display:flex;gap:38px;flex-wrap:wrap}
    .stats b{font-family:var(--serif);font-size:2rem;display:block;line-height:1}
    .stats span{font-size:12px;letter-spacing:1px;color:var(--muted)}
    /* builder */
    .builder{margin-top:10px}
    .step{padding:22px 0;border-top:1px solid var(--line)}
    .step-n{font-size:12px;letter-spacing:2px;color:var(--gold);font-weight:600;display:block;margin-bottom:14px}
    .opts{display:flex;flex-wrap:wrap;gap:10px}
    .opt{position:relative}
    .opt input{position:absolute;opacity:0}
    .opt span{display:inline-block;padding:10px 18px;border:1px solid var(--line);border-radius:40px;cursor:pointer;font-size:15px;transition:.2s}
    .opt input:checked+span{background:var(--ink);color:var(--paper);border-color:var(--ink)}
    .opt input:focus-visible+span{outline:2px solid var(--gold);outline-offset:2px}
    .fields{display:grid;gap:12px}
    .fields input,.fields textarea{width:100%;padding:13px 16px;border:1px solid var(--line);border-radius:10px;background:var(--card);color:var(--ink);font-family:var(--sans);font-size:15px}
    /* lightbox / screening room */
    .lightbox{position:fixed;inset:0;z-index:100;background:#0D0D0D;display:none;align-items:center;justify-content:center;padding:40px 20px}
    .lightbox.open{display:flex}
    .lb-close{position:absolute;top:20px;right:26px;background:none;border:0;color:#fff;font-size:40px;cursor:pointer;line-height:1}
    .lb-inner{display:grid;grid-template-columns:1.6fr 1fr;gap:34px;max-width:1100px;width:100%;align-items:center}
    .lb-media img{width:100%;border-radius:12px}
    .lb-story{color:#f2efe8}
    .lb-story h3{font-size:2rem;margin:6px 0 10px}
    .lb-loc{margin-bottom:18px}
    .lb-notes{color:#cfcabf;line-height:1.7}
    @media(max-width:820px){
      .svc-grid{grid-template-columns:1fr}
      .grid{grid-template-columns:1fr 1fr}
      .about-grid{grid-template-columns:1fr;gap:28px}
      .lb-inner{grid-template-columns:1fr;gap:20px;max-height:86vh;overflow:auto}
    }
    @media(max-width:560px){.grid{grid-template-columns:1fr}}
  </style>

  <!-- portfolio data for the lightbox JS -->
  <script type="application/json" id="pf-data" set:html={JSON.stringify(portfolio)}></script>

  <script is:inline>
    // ---- Story Lens: parallax on hero layers ----
    (function(){
      var hero=document.querySelector('.hero'), back=document.querySelector('.hero-layer.back'), front=document.querySelector('.hero-layer.front');
      if(!hero) return;
      function move(x,y){
        if(window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var cx=(x/window.innerWidth-.5), cy=(y/window.innerHeight-.5);
        back.style.transform='translate('+(cx*-18)+'px,'+(cy*-18)+'px)';
        front.style.transform='translate('+(cx*14)+'px,'+(cy*14)+'px)';
      }
      hero.addEventListener('mousemove',function(e){move(e.clientX,e.clientY)});
      window.addEventListener('deviceorientation',function(e){
        if(e.gamma==null)return; move((e.gamma+45)/90*window.innerWidth,(e.beta)/90*window.innerHeight);
      });
    })();

    // ---- Portfolio filter ----
    (function(){
      var btns=document.querySelectorAll('.filt'), cards=document.querySelectorAll('#grid .card');
      btns.forEach(function(b){b.addEventListener('click',function(){
        btns.forEach(function(x){x.classList.remove('on')}); b.classList.add('on');
        var c=b.dataset.cat;
        cards.forEach(function(card){card.style.display=(c==='All'||card.dataset.cat===c)?'':'none'});
      })});
    })();

    // ---- Screening Room lightbox ----
    (function(){
      var lb=document.getElementById('lightbox'), media=document.getElementById('lbMedia');
      var T=document.getElementById('lbTitle'),L=document.getElementById('lbLoc'),C=document.getElementById('lbClient'),N=document.getElementById('lbNotes');
      function ytId(u){var m=u.match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/)|youtu\.be\/)([A-Za-z0-9_-]{6,})/);return m?m[1]:null;}
      function embedFor(type,url){
        var yid=ytId(url);
        if(yid){var vert=/shorts/.test(url)||type==='video_vertical';
          return '<div class="embed '+(vert?'ratio-vertical':'ratio-wide')+'" style="position:relative;'+(vert?'aspect-ratio:9/16;max-width:360px;margin:0 auto;':'aspect-ratio:16/9;')+'border-radius:12px;overflow:hidden"><iframe src="https://www.youtube.com/embed/'+yid+'?rel=0" style="position:absolute;inset:0;width:100%;height:100%;border:0" allowfullscreen></iframe></div>';}
        if(/tiktok\.com/.test(url)){var m=url.match(/video\/(\d+)/);return '<div style="aspect-ratio:9/16;max-width:340px;margin:0 auto;border-radius:12px;overflow:hidden"><iframe src="https://www.tiktok.com/embed/v2/'+(m?m[1]:'')+'" style="width:100%;height:100%;border:0"></iframe></div>';}
        if(/instagram\.com/.test(url)){var m=url.match(/(reel|p)\/([A-Za-z0-9_-]+)/);return '<div style="aspect-ratio:9/16;max-width:340px;margin:0 auto;border-radius:12px;overflow:hidden"><iframe src="https://www.instagram.com/'+(m?m[1]:'p')+'/'+(m?m[2]:'')+'/embed" style="width:100%;height:100%;border:0"></iframe></div>';}
        if(/facebook\.com|fb\.watch/.test(url)){return '<div style="aspect-ratio:16/9;border-radius:12px;overflow:hidden"><iframe src="https://www.facebook.com/plugins/video.php?href='+encodeURIComponent(url)+'&show_text=false" style="width:100%;height:100%;border:0" allowfullscreen></iframe></div>';}
        return '<img src="'+url+'" alt=""/>';
      }
      document.querySelectorAll('#grid .card').forEach(function(card){
        card.addEventListener('click',function(){
          var t=card.dataset.type,u=card.dataset.url;
          media.innerHTML=(t==='photo')?'<img src="'+u+'" alt="">':embedFor(t,u);
          T.textContent=card.dataset.title; L.textContent=card.dataset.loc;
          C.textContent=card.dataset.client; N.textContent=card.dataset.notes;
          lb.classList.add('open'); document.body.style.overflow='hidden';
        });
      });
      function close(){lb.classList.remove('open');media.innerHTML='';document.body.style.overflow='';}
      document.getElementById('lbClose').addEventListener('click',close);
      lb.addEventListener('click',function(e){if(e.target===lb)close()});
      document.addEventListener('keydown',function(e){if(e.key==='Escape')close()});
    })();
  </script>
</Base>
