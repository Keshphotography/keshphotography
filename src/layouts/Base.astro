---
import '../styles/global.css';
import site from '../data/site.json';
const { title = site.brand_name, description = "Keshphotography — photography, cinematography and media. Nairobi." } = Astro.props;
---
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
  <title>{title}</title>
  <meta name="description" content={description}/>
  <link rel="icon" type="image/svg+xml" href="/images/logo-visual-thread.svg"/>
  <script is:inline>
    // apply saved theme before paint (no flash)
    (function(){try{var t=localStorage.getItem('kesh-theme');if(t)document.documentElement.dataset.theme=t;}catch(e){}})();
  </script>
</head>
<body>
  <header class="nav">
    <div class="wrap navrow">
      <a class="brand" href="/">
        <img src={site.logo} alt={site.brand_name} class="brand-mark"/>
        <span class="brand-name">{site.brand_name}</span>
      </a>
      <nav class="links" id="links">
        <a href="/#work">Work</a>
        <a href="/#services">Services</a>
        <a href="/#about">About</a>
        <a href="/#story">Build Your Story</a>
        <button id="themeToggle" class="themebtn" aria-label="Toggle cinema dark mode">
          <span class="dot"></span><span class="tlabel">Cinema</span>
        </button>
      </nav>
      <button id="menuBtn" class="menubtn" aria-label="Menu">&#9776;</button>
    </div>
  </header>

  <main>
    <slot/>
  </main>

  <footer class="foot">
    <div class="wrap footrow">
      <div>
        <div class="serif footname">{site.brand_name}</div>
        <p class="muted">{site.tagline}</p>
        <p class="muted" style="margin-top:8px;font-style:italic">{site.philosophy}</p>
      </div>
      <div class="footlinks">
        <a href={site.instagram} target="_blank" rel="noopener">Instagram</a>
        <a href={site.youtube} target="_blank" rel="noopener">YouTube</a>
        <a href={site.tiktok} target="_blank" rel="noopener">TikTok</a>
        <a href={site.facebook} target="_blank" rel="noopener">Facebook</a>
      </div>
      <div class="footcontact">
        <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">{site.phone}</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>
    <div class="wrap copyr muted">© {new Date().getFullYear()} {site.brand_name} · Nairobi, Kenya</div>
  </footer>

  <style>
    .nav{position:fixed;top:0;left:0;right:0;z-index:60;backdrop-filter:blur(12px);background:color-mix(in srgb,var(--paper) 78%,transparent);border-bottom:1px solid var(--line)}
    .navrow{display:flex;align-items:center;justify-content:space-between;padding:12px 26px}
    .brand{display:flex;align-items:center;gap:12px}
    .brand-mark{width:40px;height:40px;color:var(--ink)}
    .brand-name{font-family:var(--serif);font-weight:700;font-size:19px;letter-spacing:.5px}
    .links{display:flex;align-items:center;gap:26px}
    .links a{font-size:15px;color:var(--ink);opacity:.82}
    .links a:hover{opacity:1}
    .themebtn{display:flex;align-items:center;gap:8px;border:1px solid var(--line);background:none;color:var(--ink);padding:7px 14px;border-radius:40px;cursor:pointer;font-family:var(--sans);font-size:13px}
    .themebtn .dot{width:10px;height:10px;border-radius:50%;background:var(--gold)}
    .menubtn{display:none;background:none;border:0;color:var(--ink);font-size:24px;cursor:pointer}
    .foot{border-top:1px solid var(--line);padding:56px 0 34px;margin-top:40px}
    .footrow{display:flex;justify-content:space-between;flex-wrap:wrap;gap:30px}
    .footname{font-size:22px}
    .footlinks,.footcontact{display:flex;flex-direction:column;gap:7px}
    .footlinks a:hover,.footcontact a:hover{color:var(--gold)}
    .copyr{margin-top:34px;padding-top:20px;border-top:1px solid var(--line);font-size:13px}
    @media(max-width:820px){
      .links{position:fixed;inset:0 0 0 auto;width:min(78vw,300px);background:var(--card);flex-direction:column;align-items:flex-start;padding:90px 28px;gap:22px;transform:translateX(100%);transition:transform .3s;border-left:1px solid var(--line)}
      .links.open{transform:translateX(0)}
      .menubtn{display:block;z-index:70}
    }
  </style>

  <script is:inline>
    // Dark mode toggle
    var tt=document.getElementById('themeToggle');
    tt && tt.addEventListener('click',function(){
      var el=document.documentElement;
      var next=el.dataset.theme==='dark'?'light':'dark';
      el.dataset.theme=next;
      try{localStorage.setItem('kesh-theme',next);}catch(e){}
    });
    // Mobile menu
    var mb=document.getElementById('menuBtn'),lk=document.getElementById('links');
    mb && mb.addEventListener('click',function(){lk.classList.toggle('open')});
    lk && lk.querySelectorAll('a').forEach(function(a){a.addEventListener('click',function(){lk.classList.remove('open')})});
  </script>
</body>
</html>
